<?xml version="1.0" encoding="UTF-8"?>
<!--
  Global Maven settings for CI, passed by the restore-maven-cache action.

  Google's mirror of Maven Central is declared as an additional repository
  instead of a mirror: Maven tries it first and falls back to Maven Central
  for artifacts the mirror has not synced yet, so new releases still resolve.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <profiles>
    <profile>
      <id>google-maven-central</id>
      <repositories>
        <repository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>google-maven-central</id>
          <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>google-maven-central</activeProfile>
  </activeProfiles>
</settings>
